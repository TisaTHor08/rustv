{
  "id": "remote-panel-launch",
  "name": "Quick launch",
  "version": "1.0.0",
  "author": "RusTV",
  "publisher": "RusTV",
  "category": "remote",
  "description": "A Mods tab panel with 12 big buttons that open YouTube, Netflix, Plex, Spotify and more on the TV in one tap.",
  "details": "Adds a Quick launch panel to the phone Mods tab with 12 buttons: YouTube, Netflix, Prime Video, Disney+, Max, Plex, Jellyfin, UGREEN Theater, Arte, Twitch, Spotify and Apple TV+. Each button sends a single openTile command, so it opens that tile on the TV home exactly like selecting it with the remote. The phone only sends a command to your PC over your local network: no internet access is needed by the mod itself.",
  "tags": [
    "remote",
    "phone",
    "launch",
    "apps",
    "shortcuts",
    "streaming"
  ],
  "license": "GPL-3.0-or-later",

# RusTV : peripherique virtuel /dev/uinput pour les touches et la souris envoyees par le telephone.
# Les utilisateurs de la session locale (uaccess) et le groupe "input" peuvent ecrire dans uinput.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
